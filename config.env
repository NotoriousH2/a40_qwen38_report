# 이 파일 하나만 고치면 모든 스크립트의 경로/포트가 바뀝니다.
# 다른 머신으로 옮길 때 여기부터 확인하세요.

# llama.cpp DFlash2 빌드 (PR #27342 head)
LLAMACPP_DIR="${LLAMACPP_DIR:-/root/build/llama.cpp-dflash2}"
LLAMACPP_PR="27342"
LLAMACPP_SHA="2f3923bc81346046aa5765dda15fb28497f49ac6"
CUDA_ARCH="${CUDA_ARCH:-86}"          # A40 = sm_86. 다른 GPU면 반드시 변경

# 모델 (GGUF)
MODEL_DIR="${MODEL_DIR:-/root/models/gguf}"
TARGET_REPO="unsloth/Qwen3.8-27B-GGUF"
TARGET_FILE="Qwen3.8-27B-UD-Q3_K_XL.gguf"          # 권장. 근거: docs/06
DRAFT_REPO="incoai/Qwen3.8-27B-DFlash2-GGUF"
DRAFT_FILE="Qwen3.8-27B-DFlash2-Q4_K_M.gguf"
ALT_TARGET_FILE="Qwen3.8-27B-UD-Q4_K_XL.gguf"      # 비교용. 느려서 권장하지 않음

# 서버
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8080}"
SLOT_SAVE_PATH="${SLOT_SAVE_PATH:-/root/llama-slots}"

# 캐시는 반드시 로컬 디스크로 (네트워크 스토리지에 두면 매우 느려집니다)
export HF_HOME="${HF_HOME:-/tmp/hf}"
